# Contoh /etc/devwf-monitor.env. Salin, isi, lalu `chmod 600`.
# Nilai asli TIDAK boleh masuk repo.
DATABASE_URL=postgres://devwf:GANTI_PASSWORD@127.0.0.1:5432/devwf_monitor

# Token bersama untuk endpoint TULIS. Membaca tetap bebas.
# Kosong = SEMUA penulisan ditolak. Harus sama dengan DEVWF_MONITOR_TOKEN
# di environment server MCP setiap mesin.
DEVWF_MONITOR_TOKEN=GANTI_TOKEN_PANJANG_ACAK

# Retensi: baris lebih tua dari ini dibuang otomatis (sekali saat start,
# lalu tiap PRUNE_EVERY_MS).
# RETENTION_DAYS=30
# SESSION_RETENTION_DAYS=7
# PRUNE_EVERY_MS=21600000

# Sesi "idle" yang lebih tua dari ini tidak ditampilkan (format interval Postgres).
# IDLE_TTL=30 minutes
# EMPTY_IDLE_TTL=5 minutes