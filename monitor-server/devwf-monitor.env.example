# Example /etc/devwf-monitor.env. Copy it, fill it in, then `chmod 600`.
# Real values must NEVER be committed to the repository.
# PostgreSQL connection string (use 127.0.0.1 for local or your private DB host).
DATABASE_URL=postgres://devwf:REPLACE_WITH_PASSWORD@127.0.0.1:5432/devwf_monitor

# Shared token for the WRITE endpoints. Reading stays open.
# Empty = ALL writes are rejected. It must match DEVWF_MONITOR_TOKEN
# in the MCP server environment on every machine.
DEVWF_MONITOR_TOKEN=REPLACE_WITH_LONG_RANDOM_TOKEN

# Retention is OFF by default: no data is deleted without permission.
# Enable it only when you really want to drop old history.
# PRUNE_ENABLED=1
# RETENTION_DAYS=30
# SESSION_RETENTION_DAYS=7
# PRUNE_EVERY_MS=21600000

# "idle" sessions older than this are not shown (Postgres interval format).
# IDLE_TTL=30 minutes
# EMPTY_IDLE_TTL=1 minute

# Origins allowed to create or revoke share links. Comma separated.
# The default already covers the Tailscale dashboard and localhost; fill this in
# only when the dashboard is opened from another address. An origin that is NOT
# listed here is rejected with 403, while a request without an Origin header
# (the tablet app) is still accepted because the required header is
# X-Devwf-Share.
# REQUIRES RESTART: this value is read once at process start
# (`systemctl restart devwf-monitor`), not on every request.
# DEVWF_SHARE_ORIGINS=http://127.0.0.1:3100,http://localhost:3100
