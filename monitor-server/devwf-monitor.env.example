# Contoh /etc/devwf-monitor.env. Salin, isi, lalu `chmod 600`.
# Nilai asli TIDAK boleh masuk repo.
DATABASE_URL=postgres://devwf:GANTI_PASSWORD@127.0.0.1:5432/devwf_monitor

# Token bersama untuk endpoint TULIS. Membaca tetap bebas.
# Kosong = SEMUA penulisan ditolak. Harus sama dengan DEVWF_MONITOR_TOKEN
# di environment server MCP setiap mesin.
DEVWF_MONITOR_TOKEN=GANTI_TOKEN_PANJANG_ACAK

# Retensi MATI secara bawaan: tidak ada data yang dihapus tanpa izin.
# Nyalakan hanya bila memang ingin membuang riwayat lama.
# PRUNE_ENABLED=1
# RETENTION_DAYS=30
# SESSION_RETENTION_DAYS=7
# PRUNE_EVERY_MS=21600000

# Sesi "idle" yang lebih tua dari ini tidak ditampilkan (format interval Postgres).
# IDLE_TTL=30 minutes
# EMPTY_IDLE_TTL=5 minutes

# Origin yang boleh membuat/mencabut tautan berbagi. Dipisah koma.
# Bawaan sudah memuat dashboard Tailscale dan localhost; isi ini hanya bila
# dashboard dibuka dari alamat lain. Origin yang TIDAK ada di sini ditolak 403,
# sedangkan permintaan tanpa Origin (aplikasi tablet) tetap diterima karena
# yang diwajibkan adalah header X-Devwf-Share.
# PERLU RESTART: nilai ini dibaca sekali saat proses start
# (`systemctl restart devwf-monitor`), bukan tiap permintaan.
# DEVWF_SHARE_ORIGINS=http://100.107.65.21:3100,http://localhost:3100