[Unit]
Description=Central approved Dev Workflow MCP releases
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=devwf-releases
Group=devwf-releases
WorkingDirectory=/opt/devwf-managed
EnvironmentFile=/etc/devwf-managed.env
Environment=HOST=100.78.134.44
Environment=PORT=3101
Environment=DEVWF_RELEASE_ROOT=/var/lib/devwf-releases
ExecStart=/usr/bin/node /opt/devwf-managed/release-server.cjs
Restart=on-failure
RestartSec=3
MemoryMax=128M
CPUQuota=20%
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
