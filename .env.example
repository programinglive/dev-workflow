# Database Configuration
# Supported types: sqlite, mysql, postgres
DEV_WORKFLOW_DB_TYPE=sqlite

# Connection URLs
# MySQL Example: mysql://user:password@localhost:3306/database
# Postgres Example: postgres://user:password@localhost:5432/database
# Postgres Docker Example: postgres://devworkflow:password@postgres:5432/devworkflow
DEV_WORKFLOW_DB_URL=

# Optional: Override user ID
# DEV_WORKFLOW_USER_ID=my-custom-user-id

# ── Homelab Development ───────────────────────────────────────────────────────
# These are reference values. Replace with your actual credentials.
# Never commit this file with real values — use .env instead.

# GitHub
GH_TOKEN=

# GitLab (profile mahardhika)
GL_TOKEN=

# Cloudflare (for wrangler / CDN)
CF_ACCOUNT_ID=
CF_API_TOKEN=

# Tailscale (for auth key generation, optional)
TAILSCALE_AUTH_KEY=

# SSH config — do NOT store private keys here.
# Private keys stay in ~/.ssh/ on each machine.
