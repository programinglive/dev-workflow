# Strict mode is the default and the only supported mode.
DEV_WORKFLOW_SECURITY_MODE=strict
DEV_WORKFLOW_DB_TYPE=sqlite
# Supply PROJECT_DATABASE_URL privately through your shell/service manager.
# Do not put its value in MCP client JSON or knowledge records.
DEV_WORKFLOW_DB_URL_ENV=
# For PostgreSQL/MySQL: DEV_WORKFLOW_DB_URL_ENV=PROJECT_DATABASE_URL
# For SQLite, omit DEV_WORKFLOW_DB_URL_ENV or leave it empty.
# Knowledge example: secret_ref: env://PROJECT_DATABASE_URL
# Runtime-only web auth secrets must be independently generated (32+ characters).
# JWT_SECRET and SESSION_SECRET: provision outside this example file.
# Never commit real credentials.
# Optional Sentry issue connector: provision the credential outside this file.
# SENTRY_ORG=your-organization
# SENTRY_HOST=sentry.io
# DEVWF_SENTRY_CONFIG=/private/device/sentry.env
